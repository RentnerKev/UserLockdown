{
  "name": "user-lockdown",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:admin dev:files",
    "dev:admin": "vite build --watch --mode admin",
    "dev:files": "vite build --watch --mode files",
    "build": "vite build --mode admin && vite build --mode files",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --deny-warnings src tests/frontend vite.config.ts",
    "format": "bun fmt src tests/frontend vite.config.ts package.json tsconfig.json tsconfig.app.json tsconfig.node.json oxlint.json bunfig.toml",
    "format:check": "bun fmt --check src tests/frontend vite.config.ts package.json tsconfig.json tsconfig.app.json tsconfig.node.json oxlint.json bunfig.toml",
    "test": "bun test --isolate",
    "test:watch": "bun test --isolate --watch"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.2.0",
    "@tanstack/react-query": "^5.106.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "1.4.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
