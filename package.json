{
  "name": "user-lockdown",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:admin dev:files",
    "dev:admin": "vite build --watch --mode admin",
    "dev:files": "vite build --watch --mode files",
    "build": "vite build --mode admin && vite build --mode files",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --deny-warnings src tests/frontend vite.config.ts vitest.config.ts",
    "format": "oxfmt --config oxfmt.json src tests/frontend vite.config.ts vitest.config.ts package.json tsconfig.json tsconfig.app.json tsconfig.node.json oxlint.json oxfmt.json",
    "format:check": "oxfmt --config oxfmt.json --check src tests/frontend vite.config.ts vitest.config.ts package.json tsconfig.json tsconfig.app.json tsconfig.node.json oxlint.json oxfmt.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.2.0",
    "@tanstack/react-query": "^5.103.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
