<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>user_lockdown</id>
	<name>User Lockdown</name>
	<summary>Manage granular access permissions for selected users</summary>
	<summary lang="de">Verwalte granulare Zugriffsrechte für ausgewählte Benutzer</summary>
	<description>Control file viewing, writing, deletion, sharing, password changes, full access, and an optional All files-only interface per user with reusable presets and configurable defaults.</description>
	<description lang="de">Steuere Dateiansicht, Schreiben, Löschen, Teilen, Passwortänderungen, Vollzugriff und eine optionale Oberfläche nur für „Alle Dateien“ je Benutzer mit wiederverwendbaren Presets und konfigurierbaren Standardrechten.</description>
	<version>1.1.0</version>
	<licence>AGPL-3.0-or-later</licence>
	<author>Kevin Sträßler</author>
	<namespace>UserLockdown</namespace>
	<documentation>
		<admin>https://github.com/RentnerKev/UserLockdown#administration</admin>
	</documentation>
	<category>security</category>
	<website>https://github.com/RentnerKev/UserLockdown</website>
	<bugs>https://github.com/RentnerKev/UserLockdown/issues</bugs>
	<repository>https://github.com/RentnerKev/UserLockdown</repository>
